# Скопируйте в .env на сервере и замените все example-значения.
POSTGRES_DB=food_for_week
POSTGRES_USER=food_for_week
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://food_for_week:replace-with-a-long-random-password@db:5432/food_for_week
APP_ENV=production
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
VITE_API_URL=https://food.example.com/api
FRONTEND_ORIGINS=https://food.example.com
